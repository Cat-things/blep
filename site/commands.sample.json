        "usage": "(member) <duration> <reason>",
        "example": "@blep 1h cooling off",
        "permissions": ["manage_roles", "moderate_members"],
        "module": "moderation",
        "parameters": ["member", "duration", "reason"]
      },
      {
        "name": "kick",
        "aliases": ["k"],
