    "moderation": [
      {
        "name": "ban",
        "aliases": ["b", "yeet"],
        "description": "Ban a member, optionally deleting their recent messages.",
        "usage": "(member) <reason>",
        "example": "@blep spamming",
        "permissions": ["ban_members"],
        "module": "moderation",
        "parameters": ["member", "reason"]
      },
      {
        "name": "jail",
        "aliases": [],
