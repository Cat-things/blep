# --- required -------------------------------------------------------------
DISCORD_TOKEN=
DATABASE_URL=postgresql://blep:blep@localhost:5432/blep
# Comma separated user IDs allowed to use developer commands
OWNER_IDS=

# --- optional -------------------------------------------------------------
# Space separated default prefixes (Blep answers to both "," and ";" by default)
DEFAULT_PREFIXES=, ;

BLEP_WEBSITE=https://blep.wtf
BLEP_DOCS=https://docs.blep.wtf
BLEP_SUPPORT=https://discord.gg/blep

# Music (Lavalink v4 - see docker-compose.yml)
LAVALINK_URI=http://localhost:2333
LAVALINK_PASSWORD=youshallnotpass
# Lavalink sources (LavaSrc). Deezer needs both a decryption key and an ARL cookie.
DEEZER_ENABLED=false
DEEZER_MASTER_DECRYPTION_KEY=
DEEZER_ARL=
APPLE_MUSIC_ENABLED=true
APPLE_MUSIC_MEDIA_API_TOKEN=

# Integrations - each feature disables itself when its key is missing
LASTFM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://blep.wtf/spotify/callback
FORTNITE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Status emojis (use custom emoji strings like <:approve:123456789> if you want)
EMOJI_APPROVE=✅
EMOJI_WARN=⚠️
EMOJI_DENY=❌
