              "commands/logging",
              "commands/messages",
              "commands/misc",
              "commands/moderation",
              "commands/music",
              "commands/reactions",
              "commands/roblox",
              "commands/roles",
              "commands/social",
              "commands/spotify",
              "commands/starboard",
              "commands/tickets",
              "commands/utility",
              "commands/vanity",
              "commands/voicemaster",
              "commands/webhooks"
