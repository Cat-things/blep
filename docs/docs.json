  },
  "navbar": {
    "links": [
      {
        "label": "Support Server",
        "href": "https://discord.gg/blep"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Invite",
      "href": "https://blep.wtf/invite"
    }
  },
  "seo": {
    "metatags": {
      "theme-color": "#FF7AA2",
      "og:site_name": "blep"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/blep",
      "github": "https://github.com/cat-things/blep"
    }
  },
  "redirects": [
    {
      "source": "/invite",
      "destination": "https://blep.wtf/invite"
    },
    {
      "source": "/discord",
      "destination": "https://discord.gg/blep"
    }
  ]
}
